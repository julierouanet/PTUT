# ── Secrets ───────────────────────────────────────────────────
.env
*.env
!.env.example
!.env.ip.example

# ── Certificats SSL (générés par setup_ubuntu.sh) ─────────────
ssl/

# ── SQLite databases ──────────────────────────────────────────
*.db
*.db-shm
*.db-wal

# ── Node.js ───────────────────────────────────────────────────
node_modules/
npm-debug.log*

# ── Flutter / Dart ────────────────────────────────────────────
flutter-app/.dart_tool/
flutter-app/build/
flutter-app/.flutter-plugins
flutter-app/.flutter-plugins-dependencies
flutter-app/.packages
flutter-app/pubspec.lock
flutter-app/.pub-cache/

# ── Docker ────────────────────────────────────────────────────
docker-data/

# ── Backups (générés par backup.sh — ne jamais committer) ─────
backups/

# ── Prompts de développement (notes internes, non versionnées) ─
prompts/

# ── OS ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDE ───────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
