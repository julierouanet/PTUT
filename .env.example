# Copier ce fichier en .env sur le VPS et remplir les valeurs

INTERNAL_SECRET=changez-moi-en-production-une-vraie-cle-secrete

KC_CLIENT_SECRET_AUTH=<secret-client-auth-service-keycloak-prod>
KC_CLIENT_SECRET_AUTH_DEV=<secret-client-auth-service-keycloak-dev>
KC_DB_PASSWORD=<mot-de-passe-postgres-keycloak>
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=<mot-de-passe-admin-keycloak>

# Web Push VAPID — générer une seule fois avec :
# node -e "const wp=require('web-push'); const k=wp.generateVAPIDKeys(); console.log(JSON.stringify(k,null,2))"
VAPID_PUBLIC_KEY=<clé_publique_base64url>
VAPID_PRIVATE_KEY=<clé_privée_base64url>
VAPID_CONTACT=mailto:admin@lucaslopvet.fr
