# ============================================================================
# .claudeignore — PTUT Kabutare (auth + db services Node.js, app Flutter, nginx)
# Objectif : ne pas charger ce qui n'apporte rien a la comprehension metier.
# ============================================================================

# -- Secrets & variables d'environnement -------------------------------------
.env
.env.*
*.env
!.env.example
*.pem
*.key
*.crt
secrets/
**/credentials.json

# -- Dependances externes ----------------------------------------------------
node_modules/
**/node_modules/
vendor/
.pub-cache/
**/.pub-cache/

# -- Lockfiles (volumineux, peu utiles a la lecture) -------------------------
package-lock.json
yarn.lock
pnpm-lock.yaml
pubspec.lock

# -- Build / dist / cache generiques -----------------------------------------
build/
**/build/
dist/
out/
.cache/
coverage/
.next/
.nuxt/
.turbo/
.parcel-cache/
.vite/

# -- Flutter / Dart : genere, plateformes natives, caches --------------------
flutter-app/.dart_tool/
flutter-app/.flutter-plugins
flutter-app/.flutter-plugins-dependencies
flutter-app/.metadata
flutter-app/.packages
flutter-app/build/

# Plateformes natives — boilerplate genere par `flutter create`,
# rarement modifiees. On garde uniquement android/app/src pour le code Kotlin/Java
# si necessaire (sinon retirer les lignes ci-dessous pour tout ignorer).
flutter-app/android/.gradle/
flutter-app/android/build/
flutter-app/android/app/build/
flutter-app/android/.kotlin/
flutter-app/android/local.properties
flutter-app/ios/
flutter-app/macos/
flutter-app/linux/
flutter-app/windows/
flutter-app/web/

# Fichiers Dart generes (build_runner, freezed, json_serializable, l10n)
**/*.g.dart
**/*.freezed.dart
**/*.gr.dart
**/*.config.dart
**/*.mocks.dart
**/generated_plugin_registrant.*
flutter-app/lib/l10n/*.g.dart

# -- Logs --------------------------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# -- Bases de donnees locales ------------------------------------------------
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
auth-service/auth.db
db-service/db.sqlite

# -- Fichiers binaires / assets lourds ---------------------------------------
# Images
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.bmp
*.tiff
*.ico
*.svg
# Polices
*.ttf
*.otf
*.woff
*.woff2
*.eot
# Audio / video
*.mp3
*.mp4
*.wav
*.avi
*.mov
*.webm
# 3D / archives
*.fbx
*.glb
*.gltf
*.obj
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z

# -- Documents bureautiques (rapport, soutenance, poster) --------------------
*.pdf
*.pptx
*.docx
*.doc
*.xls
*.xlsx
~$*
Rapport_final_PTUT_ISIS_Kabutare.pdf
poster.pptx
soutenance_ptut.pptx.pdf
document important/

# -- Code de reference Figma (prototype, hors prod) --------------------------
figma code/**/node_modules/
figma code/**/dist/
figma code/**/build/
figma code/**/.vite/

# -- Docker / volumes / runtime ----------------------------------------------
docker-data/
**/data/
*.pid

# -- Fichiers generes / minifies ---------------------------------------------
*.min.js
*.min.css
*.map
*.lock

# -- OS ----------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# -- IDE ---------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*.iml

# -- Git & sessions Claude ---------------------------------------------------
.git/
.claude/worktrees/
