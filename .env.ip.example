# ============================================================
# Variables d'environnement — déploiement IP-only
# Copier ce fichier en .env et remplir toutes les valeurs
# ============================================================

# ── Serveur ──────────────────────────────────────────────────
# IP publique du serveur Ubuntu (détectée automatiquement par setup_ubuntu.sh)
SERVER_IP=

# ── Docker Hub ───────────────────────────────────────────────
# Votre username Docker Hub (utilisé pour pull les images)
DOCKER_USER=

# ── Secrets applicatifs ──────────────────────────────────────
# Clé de communication inter-services (générer avec : openssl rand -hex 32)
INTERNAL_SECRET=

# ── Keycloak ─────────────────────────────────────────────────
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=

# Secret du client Keycloak "auth-service" (créé dans l'admin Keycloak)
KC_CLIENT_SECRET_AUTH=

# Mot de passe PostgreSQL pour Keycloak (générer avec : openssl rand -hex 16)
KC_DB_PASSWORD=

# ── Web Push VAPID (optionnel) ────────────────────────────────
# Générer avec : node -e "const wp=require('web-push'); const k=wp.generateVAPIDKeys(); console.log(JSON.stringify(k,null,2))"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:admin@hospital.local

# ── Brevo SMTP (optionnel — nécessaire pour les emails Keycloak) ──────────────
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=
BREVO_SMTP_PASSWORD=
BREVO_FROM_EMAIL=noreply@hospital.local
BREVO_FROM_NAME=Hôpital de Kabutare

# ── Brevo API (optionnel — pour emails transactionnels des microservices) ─────
BREVO_API_KEY=
